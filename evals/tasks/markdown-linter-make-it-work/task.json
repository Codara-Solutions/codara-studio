{
  "id": "markdown-linter-make-it-work",
  "title": "Make the vendored markdown linter work on our docs",
  "version": "1.0",
  "budgetSeconds": 2700,
  "allowedPaths": [
    "vendor/markdown-linter/"
  ],
  "forbiddenPaths": [
    "src/",
    "evals/",
    "tests/",
    "resources/",
    "package.json",
    "package-lock.json",
    "electron.vite.config.ts",
    "playwright.config.ts"
  ],
  "publicGates": [
    "public-gates.json"
  ],
  "judgeBlindList": [
    "spark",
    "Spark",
    "SPARK",
    "spark_full",
    "SparkFullRunner",
    "claude_best",
    "claude_best_single",
    "ClaudeBestSingle",
    "ClaudeBestSingleRunner",
    "codex_best",
    "codex_best_single",
    "CodexBestSingle",
    "CodexBestSingleRunner",
    "spark-agent",
    "SparkAgent"
  ],
  "publicGateSummaryForJudge": "vendor/markdown-linter tests must still pass via `npm test --prefix vendor/markdown-linter`. The CLI must still run on the docs/ folder without crashing (it may exit non-zero when issues are found).",
  "hiddenGateSummaryForJudgeTemplate": "Hidden adversarial probes: {passed}/{total} passed."
}
