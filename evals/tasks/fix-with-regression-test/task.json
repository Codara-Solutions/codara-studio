{
  "id": "fix-with-regression-test",
  "title": "Fix the OpenRouter structured-output classifier with a regression test",
  "version": "1.0",
  "budgetSeconds": 3600,
  "allowedPaths": [
    "src/main/orchestration/",
    "tests/"
  ],
  "forbiddenPaths": [
    "src/renderer/",
    "src/preload/",
    "src/shared/",
    "resources/orchestration/",
    "evals/",
    "package.json",
    "package-lock.json",
    "electron.vite.config.ts",
    "playwright.config.ts"
  ],
  "publicGates": [
    "public-gates.json"
  ],
  "judgeBlindList": [
    "spark",
    "Spark",
    "SPARK",
    "claude_best_single",
    "claude_best",
    "ClaudeBestSingle",
    "ClaudeBestSingleRunner",
    "spark_full",
    "SparkFullRunner",
    "Codex",
    "codex",
    "spark-agent",
    "SparkAgent"
  ],
  "publicGateSummaryForJudge": "npm run typecheck must pass and the regression test (`node --test --experimental-strip-types tests/openrouter-error-classifier.test.ts`) must exit zero.",
  "hiddenGateSummaryForJudgeTemplate": "Hidden adversarial fixtures: {passed}/{total} passed."
}
