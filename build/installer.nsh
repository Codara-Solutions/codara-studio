; Removes what src/main/open-with.ts registers for Explorer: the "Open in
; Codara Studio" verb, the Open With entry, and its ProgID. The running app
; writes these under HKCU, so the uninstaller is the only place to clean up.
; An update also runs the old uninstaller; skip then, or every update would
; drop the entries until the next change to the registered command.
!macro customUnInstall
  ${ifNot} ${isUpdated}
    DeleteRegKey HKCU "Software\Classes\CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.png\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.jpg\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.jpeg\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.webp\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.gif\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.bmp\shell\CodaraStudio.Open"
    DeleteRegValue HKCU "Software\Classes\.bmp\OpenWithProgids" "CodaraStudio.Preview"
    DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ico\shell\CodaraStudio.Open"
