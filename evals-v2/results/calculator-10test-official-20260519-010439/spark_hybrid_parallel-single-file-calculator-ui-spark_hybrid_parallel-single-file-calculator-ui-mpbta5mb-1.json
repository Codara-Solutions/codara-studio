        {
          "id": "public-one-html-file-only",
          "description": "node -e \"const fs=require('fs'); const files=fs.readdirSync('.', {withFileTypes:true}).filter(e=>e.isFile()).map(e=>e.name).sort(); const html=files.filter(f=>/\\.html$/i.test(f)); if(html.length!==1) throw new Error('expected exactly one html file, got '+files.join(',')); const allowed=new Set(['spark-eval-plan.md', html[0]]); const extra=files.filter(f=>!allowed.has(f)); if(extra.length) throw new Error('extra files: '+extra.join(',')); const text=fs.readFileSync(html[0],'utf8'); if(!/<style[\\s>]/i.test(text)||!/<script[\\s>]/i.test(text)) throw new Error('missing inline style/script'); if(/<(script|link)[^>]+(src|href)=/i.test(text)) throw new Error('external asset reference found');\"",
          "ok": true,
          "durationMs": 47,
          "message": "passed"
        },
        {
          "id": "public-calculator-controls",
          "description": "node -e \"const fs=require('fs'); const html=fs.readdirSync('.').find(f=>/\\.html$/i.test(f)); if(!html) throw new Error('missing html file'); const text=fs.readFileSync(html,'utf8'); const buttonCount=(text.match(/<button\\b/gi)||[]).length; if(buttonCount<16) throw new Error('expected at least 16 calculator buttons, got '+buttonCount); for(const digit of '0123456789'){ const digitPattern=new RegExp('(<button[^>]*>'+digit+'<)|((data-digit|value)=.?'+digit+')','i'); if(!digitPattern.test(text)) throw new Error('missing digit '+digit); } for(const label of ['+','-','=']) if(!text.includes(label)) throw new Error('missing operator '+label); if(!/data-op=.?[\\u002f]|>\\/<|\\u00f7/.test(text)) throw new Error('missing division operator'); if(!/data-op=.?\\*|>\\*<|\\u00d7/.test(text)) throw new Error('missing multiplication operator'); if(!/(AC|Clear|C)<|clear/i.test(text)) throw new Error('missing clear control'); if(!/(display|screen|result|output)/i.test(text)) throw new Error('missing display/result surface');\"",
          "ok": true,
          "durationMs": 48,
          "message": "passed"
        }
      ]
    },
