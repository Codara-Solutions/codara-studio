        {
          "id": "hidden-professional-self-contained-ui",
          "description": "node -e \"const fs=require('fs'); const html=fs.readdirSync('.').find(f=>/\\.html$/i.test(f)); const text=fs.readFileSync(html,'utf8'); const style=(text.match(/<style[^>]*>([\\s\\S]*?)<\\/style>/i)||[])[1]||''; if(style.length<1200) throw new Error('CSS too thin for a professional UI: '+style.length+' chars'); for(const need of ['grid','hover','focus','border-radius','box-shadow']) if(!style.toLowerCase().includes(need)) throw new Error('missing UI polish signal: '+need); if(!/@media|clamp\\(|min\\(|max\\(/i.test(style)) throw new Error('missing responsive sizing signal'); if(/eval\\s*\\(|new Function/i.test(text)) throw new Error('unsafe expression evaluation'); if(!/addEventListener|onclick|data-/.test(text)) throw new Error('missing interactive event wiring');\"",
          "ok": true,
          "durationMs": 47,
          "message": "passed"
        },
        {
          "id": "hidden-accessible-html-shape",
          "description": "node -e \"const fs=require('fs'); const html=fs.readdirSync('.').find(f=>/\\.html$/i.test(f)); const text=fs.readFileSync(html,'utf8'); if(!/<main[\\s>]/i.test(text)) throw new Error('missing semantic main'); if(!/(aria-label|aria-live|role=)/i.test(text)) throw new Error('missing basic aria semantics'); if(!/<meta[^>]+viewport/i.test(text)) throw new Error('missing viewport meta'); if(!/<title>[^<]*(calculator|calc)/i.test(text)) throw new Error('title should identify calculator');\"",
          "ok": true,
          "durationMs": 47,
          "message": "passed"
        },
        {
          "id": "hidden-keyboard-focus-behavior",
          "description": "node -e \"const project=process.env.SPARK_EVAL_PROJECT_ROOT||'C:/Users/Etienne/Documents/Project/Spark-Agent'; const {chromium}=require(project+'/node_modules/playwright'); const fs=require('fs'); const path=require('path'); const html=fs.readdirSync('.').find(f=>/\\.html$/i.test(f)); if(!html) throw new Error('missing html file'); const url='file:///'+path.resolve(html).replace(/\\\\/g,'/'); const button=async(page,rx,text)=>{ let loc=page.getByRole('button',{name:rx}).first(); if(await loc.count()) return loc; if(text){ loc=page.locator('button').filter({hasText:text}).first(); if(await loc.count()) return loc; } throw new Error('missing button '+rx); }; const display=async(page)=>((await page.locator('output,[aria-live],#current,#value,.display,.screen,.result').first().textContent())||'').trim(); const has=(text,expected)=>String(text).split(/\\s+/).includes(expected); (async()=>{ const browser=await chromium.launch({headless:true}); const page=await browser.newPage({viewport:{width:390,height:720}}); await page.goto(url); await (await button(page,/^(AC|Clear|C)$/i)).click(); await page.keyboard.press('7'); await page.keyboard.press('/'); await page.keyboard.press('2'); await page.keyboard.press('Enter'); let value=await display(page); if(!has(value,'3.5')) throw new Error('keyboard divide expected 3.5, got '+value); await (await button(page,/^(AC|Clear|C)$/i)).click(); await (await button(page,/^2$/)).click(); await (await button(page,/^(Add|\\+)$/i,'+')).click(); await (await button(page,/^3$/)).click(); await (await button(page,/^(Equals|=)$/i,'=')).focus(); await page.keyboard.press('Enter'); value=await display(page); if(!has(value,'5')) throw new Error('focused equals expected 5, got '+value); await (await button(page,/^(AC|Clear|C)$/i)).focus(); await page.keyboard.press('Enter'); value=await display(page); if(!has(value,'0')) throw new Error('focused clear expected 0, got '+value); await browser.close(); })().catch(err=>{ console.error(err.stack||err.message); process.exit(1); });\"",
