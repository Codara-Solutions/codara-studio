    "popup.html": [
      {
        "find": "<label class=\"row\">\n        <span class=\"grow\">Open new tabs in a group</span>",
        "replace": "<label class=\"row\" style=\"display: none\">\n        <span class=\"grow\">Open new tabs in a group</span>"
      },
      {
        "find": "    <section id=\"reach\" class=\"sec\" hidden>",
        "replace": "    <section id=\"access\" class=\"sec ask\" aria-labelledby=\"access-label\" hidden>\n      <div id=\"access-label\" class=\"lbl\">Firefox needs your OK</div>\n      <div id=\"access-rows\" style=\"display: grid; gap: 12px\"></div>\n    </section>\n\n    <section id=\"reach\" class=\"sec\" hidden>"
      },
      {
        "find": "<script type=\"module\" src=\"popup.js\"></script>",
        "replace": "<script type=\"module\" src=\"popup.js\"></script>\n    <script type=\"module\" src=\"access.js\"></script>"
      }
    ]
  }
