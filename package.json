    "test:step-lifecycle": "node scripts/test-step-lifecycle.cjs",
    "test:followup-rehoming": "node scripts/test-followup-rehoming.cjs",
    "test:spawn-batch-guard": "node scripts/test-spawn-batch-guard.cjs",
    "test:wedged-run": "node scripts/test-wedged-run-recovery.cjs",
    "test:agent-liveness": "node scripts/test-agent-liveness.cjs",
    "test:orchestration-timeouts": "node scripts/test-orchestration-timeout-margin.cjs",
    "test:run-recovery-contracts": "node scripts/test-run-recovery-contracts.cjs",
    "test:parallel-wave": "node scripts/test-parallel-wave.cjs",
    "test:outcome-memory": "node scripts/test-outcome-memory.cjs",
    "test:manager-prompt-cache": "node scripts/test-manager-prompt-cache.cjs",
    "test:manager-call-settlement": "node scripts/test-manager-call-settlement.cjs",
    "test:codara-complete-application": "node scripts/test-codara-complete-application.cjs",
    "test:cora-memory": "node scripts/test-cora-memory.cjs && node scripts/test-workspace-lessons.cjs",
    "test:completion-tail": "node scripts/test-completion-tail.cjs",
    "test:pi-runtime": "node scripts/test-pi-runtime.cjs && node scripts/test-pi-backend-session-lifecycle.cjs && node scripts/test-pi-mcp-config.cjs && node scripts/test-pi-verification.cjs && node scripts/test-pi-admission-cache.mjs && node scripts/test-pi-frontier-evidence.cjs && node scripts/test-pi-frontier-gate.mjs && node scripts/test-pi-worker-harness-gate.cjs && node scripts/test-pi-worker-providers.cjs",
    "test:pi-commit-message": "node scripts/test-pi-commit-message.cjs",
    "test:pi-worker-harness": "node scripts/test-pi-worker-harness-gate.cjs && node scripts/test-pi-worker-providers.cjs",
    "test:pi-frontier-gate": "node scripts/test-pi-frontier-gate.mjs",
    "test:pi-rpc": "node scripts/test-pi-rpc-client.cjs",
    "test:pi-turn": "node scripts/test-pi-turn.cjs && node scripts/test-pi-cora-extension.cjs",
    "test:pi-account-router": "node scripts/test-pi-account-router.cjs && node scripts/test-pi-usage-applicability.cjs && node scripts/test-pi-account-execution.cjs && node scripts/test-pi-subscription-usage-profiles.cjs",
    "test:deep-search": "node scripts/test-deep-search.cjs",
    "test:failure-taxonomy": "node scripts/test-failure-taxonomy.cjs",
    "test:late-failure-preservation": "node scripts/test-late-failure-preservation.cjs",
    "test:repeat-guard": "node scripts/test-repeat-guard.cjs",
    "smoke:pi-live": "node scripts/smoke-pi-live.cjs",
    "smoke:pi-worker-live": "node scripts/smoke-pi-worker-live.cjs",
    "smoke:pi-frontier-live": "node scripts/smoke-pi-frontier-live.cjs",
    "smoke:pi-frontier-admission-live": "node scripts/smoke-pi-frontier-live.cjs",
    "smoke:pi-frontier-blocker-live": "node scripts/smoke-pi-frontier-blocker-live.cjs",
    "smoke:pi-frontier-contract-revision-live": "node scripts/smoke-pi-frontier-contract-revision-live.cjs",
    "profile:pi-subagent-lifecycle": "node scripts/profile-pi-subagent-lifecycle.cjs",
    "inspect-run": "node scripts/inspect-run.cjs",
    "test:worktrees": "node scripts/test-worktrees.cjs",
    "test:workspace-colors": "node scripts/test-workspace-colors.cjs",
    "test:worktree-delete-dialog": "node scripts/test-worktree-delete-dialog.cjs",
    "eval:v2:noop": "node evals-v2/run-benchmark.cjs --adapter noop --repetitions 1",
    "eval:v2:peer": "node evals-v2/run-benchmark.cjs --variants spark_sequential,spark_hybrid_parallel --tasks peer-mailbox-analytics-contract --repetitions 1",
    "eval:v2:test-plan": "node evals-v2/run-benchmark.cjs --variants spark_sequential,spark_hybrid_parallel --tasks single-file-calculator-ui --repetitions 1",
    "eval:v2:judge": "node evals-v2/lib/judge.cjs",
    "eval:v2:scorecard": "node evals-v2/lib/scorecard.cjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "test:usage-windows": "node scripts/test-usage-windows.cjs",
    "test:usage-analytics": "node scripts/test-usage-analytics.cjs",
    "test:github-work-queue": "node scripts/test-github-work-queue.cjs",
    "test:capability-center": "node scripts/test-capability-center-ui.cjs",
    "test:github-pr-import": "node scripts/test-github-pull-request-git.cjs && node scripts/test-github-pull-request-import-journal.cjs && node scripts/test-github-pull-request-workspace.cjs && node scripts/test-untrusted-pr-policy.cjs && node scripts/test-github-pull-request-surface.cjs",
    "test:prompt-punctuation": "node scripts/test-prompt-punctuation.cjs",
    "test:cora-evidence-rules": "node scripts/test-cora-evidence-rules.cjs",
    "test:worker-pane-harness-gate": "node scripts/test-worker-pane-harness-gate.cjs",
    "test:worker-cleanup-safety": "node scripts/test-worker-cleanup-safety.cjs",
    "test:codex-cli-account-profiles": "node scripts/test-codex-cli-account-profiles.cjs",
    "test:native-cli-shared-state": "node scripts/test-native-cli-shared-state.cjs",
    "test:codex-cli-profile-execution": "node scripts/test-codex-cli-profile-execution.cjs",
    "test:claude-cli-account-profiles": "node scripts/test-claude-cli-account-profiles.cjs",
    "test:account-identity": "node scripts/test-anthropic-account-identity.cjs && node scripts/test-native-cli-accounts.cjs && node scripts/test-native-cli-account-wiring.cjs && node scripts/test-pi-account-settings-surface.cjs && node scripts/test-login-return-focus.cjs",
    "test:native-cli-terminal-removal": "node scripts/test-native-cli-terminal-removal.cjs",
    "test:native-cli-shell-defaults": "node scripts/test-native-cli-shell-defaults.cjs",
    "test:claude-cli-profile-execution": "node scripts/test-claude-cli-profile-execution.cjs",
    "test:codex-home-routing": "node scripts/test-codex-home-routing.cjs",
    "test:pty-resource-governor": "node scripts/test-pty-spawn-serialization.cjs",
    "test:posix-pty-tree-cleanup": "node scripts/test-posix-pty-tree-cleanup.cjs",
    "test:manager-playbooks": "node scripts/test-manager-playbooks.cjs",
    "test:chat-timeline": "node scripts/test-chat-timeline.cjs",
    "test:composer-fast-mode": "node scripts/test-composer-fast-mode.cjs",
    "test:codex-worker-fast-mode": "node scripts/test-codex-worker-fast-mode.cjs",
    "test:worker-independence": "node scripts/test-worker-independence.cjs",
    "test:peer-comms-opt-in": "node scripts/test-peer-comms-opt-in.cjs",
    "test:verifier-scoping": "node scripts/test-verifier-scoping.cjs",
    "test:user-message-resume": "node scripts/test-user-message-resume.cjs",
    "test:force-pause-resume": "node scripts/test-force-pause-resume.cjs",
    "test:queued-messages": "node scripts/test-queued-messages.cjs",
    "test:run-resume-guard": "node scripts/test-run-resume-guard.cjs",
    "test:run-graph-layout": "node scripts/test-run-graph-layout.cjs",
    "test:run-verdict": "node scripts/test-run-verdict.cjs",
    "test:pane-format": "node scripts/test-pane-format.cjs",
    "test:navigation-allowlist": "node scripts/test-navigation-allowlist.cjs",
    "test:hook-installer": "node scripts/test-hook-installer.cjs",
    "test:hook-watcher": "node scripts/test-hook-watcher-lifecycle.cjs",
    "test:fs-watcher": "node scripts/test-fs-watcher-lifecycle.cjs",
    "test:renderer-boot": "node scripts/test-renderer-boot-ready.cjs",
    "test:ipc-gate": "node scripts/test-ipc-gate-default.cjs",
    "test:fs-sandbox": "node scripts/test-fs-sandbox.cjs",
    "test:declared-deps": "node scripts/test-declared-deps.cjs",
    "test:trusted-sender": "node scripts/test-trusted-sender.cjs",
    "test:remote-access": "node scripts/test-remote-access.cjs",
    "test:ssh-keys": "node scripts/test-ssh-keys.cjs",
    "test:remote-cora-contract": "node scripts/test-remote-cora-contract.cjs",
    "test:cora-history-interop": "node scripts/test-cora-history-interop.cjs",
    "test:cora-run-interop": "node scripts/test-cora-run-interop.cjs",
    "test:remote-access-e2e": "node scripts/remote-access-e2e.mjs",
    "test:remote-access-hostile": "node --expose-gc scripts/test-remote-access-hostile.mjs",
    "test:worker-terminal-controls": "node scripts/test-worker-terminal-controls.cjs",
    "test:chat-surface-routing": "node scripts/test-chat-surface-routing.cjs",
    "test:tab-reorder": "node scripts/test-tab-reorder.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.209",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@hyperswarm/secret-stream": "^6.9.1",
    "@iconify-json/catppuccin": "^1.2.17",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@uiw/codemirror-theme-atomone": "^4.25.9",
    "@uiw/codemirror-theme-aura": "^4.25.9",
    "@uiw/codemirror-theme-copilot": "^4.25.9",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/codemirror-theme-nord": "^4.25.9",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.9",
    "@uiw/codemirror-theme-xcode": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.0",
    "croner": "^10.0.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.10.0",
    "mermaid": "^11.4.1",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^6.1.200",
    "pi-web-search": "1.3.1",
    "qrcode": "^1.5.4",
    "react-markdown": "^9.0.3",
    "react-virtuoso": "^4.18.7",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "sodium-native": "^5.1.0",
    "ssh-config": "^5.2.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.codara.app",
    "productName": "Codara Studio",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/node-pty/build/Release/**/*.{pdb,iobj,ipdb,exp,lib,obj}",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/linux-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/prebuilds/win32-ia32/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@earendil-works/pi-coding-agent/node_modules/**/*.node",
      "node_modules/pi-web-search/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-${os}-${arch}/**",
      "node_modules/sodium-native/**",
      "node_modules/udx-native/**"
    ],
    "extraResources": [
      "build/icon.ico",
      "build/icon.png",
      {
        "from": "resources/shell-integration",
        "to": "shell-integration"
      },
      {
        "from": "resources/orchestration",
        "to": "orchestration"
      },
      {
        "from": "resources/claude-hooks",
        "to": "claude-hooks"
      },
      {
        "from": "resources/codara-studio-mcp",
        "to": "codara-studio-mcp"
      },
      {
        "from": "resources/pi-cora",
        "to": "pi-cora"
      },
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "bin/cora.cjs",
        "to": "cora-cli/cora.cjs"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "Codara-Solutions",
      "repo": "codara-studio"
    }
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "electron@43.1.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true
  }
}
