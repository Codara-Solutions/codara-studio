{
  "name": "codara-studio",
  "version": "0.3.0",
  "description": "Codara Studio — cross-platform terminal multiplexer and agent cockpit, driven by Cora, its built-in agent",
  "main": "out/main/index.js",
  "author": "Etienne",
  "private": true,
  "bin": {
    "cora": "bin/cora.cjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:safe": "cmd /c start /b /wait /affinity FFFFF0FF cmd /c electron-vite build",
    "test:renderer-chunks": "node scripts/test-renderer-chunks.mjs",
    "test:preview-webview": "node scripts/test-browser-pane-webview-liveness.cjs && node scripts/test-preview-navigation.cjs",
    "start": "electron-vite preview",
    "cora": "node bin/cora.cjs",
    "test:cora-cli": "node scripts/test-cora-cli.cjs",
