{
  "name": "spark-agent",
  "version": "0.1.0",
  "description": "Spark Agent — cross-platform terminal multiplexer",
  "main": "out/main/index.js",
  "author": "Etienne",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "inspect-run": "node scripts/inspect-run.cjs",
    "eval:v2:noop": "node evals-v2/run-benchmark.cjs --adapter noop --repetitions 1",
    "eval:v2:peer": "node evals-v2/run-benchmark.cjs --variants spark_sequential,spark_hybrid_parallel --tasks peer-mailbox-analytics-contract --repetitions 1",
    "eval:v2:test-plan": "node evals-v2/run-benchmark.cjs --variants spark_sequential,spark_hybrid_parallel --tasks single-file-calculator-ui --repetitions 1",
    "eval:v2:judge": "node evals-v2/lib/judge.cjs",
    "eval:v2:scorecard": "node evals-v2/lib/scorecard.cjs",
    "test:e2e": "npm run build && playwright test",
    "test:user-flow": "npm run build && node tests/e2e/run-user-flow-test.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@iconify-json/catppuccin": "^1.2.17",
    "@replit/codemirror-vim": "^6.3.0",
    "@uiw/codemirror-theme-atomone": "^4.25.9",
    "@uiw/codemirror-theme-aura": "^4.25.9",
    "@uiw/codemirror-theme-copilot": "^4.25.9",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/codemirror-theme-nord": "^4.25.9",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.9",
    "@uiw/codemirror-theme-xcode": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.spark.agent",
    "productName": "Spark Agent",
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/node-pty/build/Release/**/*.{pdb,iobj,ipdb,exp,lib,obj}",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/linux-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/prebuilds/win32-ia32/**"
    ],
    "asarUnpack": [
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-${os}-${arch}/**"
    ],
    "extraResources": [
      "build/icon.ico",
      {
        "from": "resources/shell-integration",
        "to": "shell-integration"
      },
      {
        "from": "resources/orchestration",
        "to": "orchestration"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
