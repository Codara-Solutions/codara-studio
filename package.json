  "build": {
    "appId": "com.codara.app",
    "productName": "Codara Studio",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/node-pty/build/Release/**/*.{pdb,iobj,ipdb,exp,lib,obj}",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/linux-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/prebuilds/win32-ia32/**"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/pi-coding-agent/node_modules/**/*.node",
      "node_modules/pi-web-search/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-${os}-${arch}/**",
      "node_modules/sodium-native/**",
      "node_modules/udx-native/**"
    ],
    "extraResources": [
      "build/icon.ico",
      "build/icon.png",
      "build/tray.png",
      {
        "from": "resources/shell-integration",
        "to": "shell-integration"
      },
      {
        "from": "resources/orchestration",
        "to": "orchestration"
      },
      {
        "from": "resources/claude-hooks",
        "to": "claude-hooks"
      },
      {
        "from": "resources/codara-studio-mcp",
        "to": "codara-studio-mcp"
      },
      {
        "from": "resources/pi-cora",
        "to": "pi-cora"
      },
      {
        "from": "cli",
        "to": "cora-cli"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "generic",
      "url": "https://studio.codarasolutions.com/releases"
    }
  }
}
