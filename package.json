  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codara-Solutions/codara-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Codara-Solutions/codara-studio/issues"
  },
  "license": "MIT",
  "author": "Codara Solutions",
